{
  "name": "@local/task-completion-notify",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pops up a toast and plays a chime when an agent finishes a task.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-api-session-controller"]
    }
  }
}
